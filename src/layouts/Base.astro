---
import '../styles/global.css';
import HelpDialog from '../components/HelpDialog.astro';
import { uiStrings, isPreview } from '../lib/site.mjs';

interface Props {
  lang: { code: string; slug: string; dir: string; name: string };
  title?: string;
  /** Hide the Help now bar (language picker page only). */
  noHelp?: boolean;
}
const { lang, title, noHelp = false } = Astro.props;
const ui = uiStrings(lang.slug);
const base = import.meta.env.BASE_URL;
// Page titles stay neutral ("REACH Pregnancy"), so the tab list and app switcher never reveal a topic.
const pageTitle = title ? `${title} · ${ui.site_name}` : ui.site_name;
---
<!doctype html>
<html lang={lang.code} dir={lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1d4e89" />
    <meta name="robots" content={isPreview() ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon-180x180.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{pageTitle}</title>
    <script is:inline defer src={`${base}registerSW.js`}></script>
  </head>
  <body class={noHelp ? '' : 'has-help'}>
    <a class="skip" href="#main">Skip to content</a>
    {isPreview() && <div class="preview-banner" role="note">{ui.preview_banner}</div>}
    <header class="top">
      <a class="brand" href={`${base}${lang.slug}/`}>{ui.site_name}</a>
      <a class="lang-switch" href={`${base}?choose=1`} aria-label={ui.language}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span>{lang.name}</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>{ui.disclaimer}</p>
    </footer>
    {!noHelp && <HelpDialog lang={lang} />}
  </body>
</html>
